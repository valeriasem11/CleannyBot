# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Строка подключения к PostgreSQL (на bothost — из панели базы данных).
# Формат: postgresql://user:password@host:port/dbname
# Если не задана — локальный SQLite-файл (только для разработки на компьютере,
# на облачном хостинге такие данные теряются при передеплое).
DATABASE_URL=

# Ваш Telegram ID: команда /chats, общая /stats и оповещения об ошибках
OWNER_USER_ID=828533150

# Задержка удаления по умолчанию, секунды (300 = 5 минут)
DELETE_DELAY_SECONDS=300

# Боты, которых не трогать во ВСЕХ чатах (ID через запятую)
WHITELIST_BOT_IDS=

# Часовой пояс по умолчанию (часы от UTC); в чате меняется командой /timezone
DEFAULT_UTC_OFFSET_HOURS=5

# Через сколько секунд убирать ответы Cleanny и команды админов (режим /tidy)
TIDY_DELAY_SECONDS=90

# Ускоренная задержка ночного режима fast, секунды
NIGHT_FAST_DELAY_SECONDS=30

# Сторож: как часто проверять очередь необработанных обновлений и порог тревоги
WATCHDOG_INTERVAL_SECONDS=300
WATCHDOG_PENDING_THRESHOLD=30
