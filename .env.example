# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Через сколько секунд после отправки удалять сообщения от других ботов
# (по умолчанию 300 = 5 минут)
DELETE_DELAY_SECONDS=300

# ID ботов, которых НЕ нужно чистить, через запятую.
# Самого Cleanny добавлять не нужно — он и так себя не трогает.
WHITELIST_BOT_IDS=

# Ваш личный Telegram ID — только вы сможете вызывать команду /chats
OWNER_USER_ID=828533150

# Строка подключения к PostgreSQL (взять в панели bothost, там где
# подключена база у вашего другого бота). Формат обычно такой:
# postgresql://user:password@host:port/dbname
# Если не задано — используется локальный SQLite-файл (только для
# разработки на своём компьютере, не переживает передеплой на хостинге!)
DATABASE_URL=

# Путь к файлу SQLite, где хранятся запланированные задачи удаления
JOBS_DB_PATH=jobs.sqlite
