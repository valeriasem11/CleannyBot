# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Через сколько секунд после отправки удалять сообщения от других ботов
# (по умолчанию 300 = 5 минут)
DELETE_DELAY_SECONDS=300

# ID ботов, которых НЕ нужно чистить, через запятую.
# Самого Cleanny добавлять не нужно — он и так себя не трогает.
WHITELIST_BOT_IDS=

# Путь к файлу SQLite, где хранятся запланированные задачи удаления
JOBS_DB_PATH=jobs.sqlite
